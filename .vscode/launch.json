{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Java: 현재 파일",
            "type": "java",
            "request": "launch",
            "mainClass": "${fileBasenameNoExtension}",
            "preLaunchTask": "Java: 현재파일 .class 생성 (컴파일)",
            "classPaths": [
                "${fileDirname}",
            ],
            "modulePaths": [
                "${fileDirname}",
            ],
            "sourcePaths": [
                "${fileDirname}",
            ],
            // "cwd": "${fileDirname}",
            "args": [
                "<",
                "${workspaceFolder}/.vscode/stdin"
            ]
        },
        {
            "name": "Python: 현재 파일",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "<",
                "${workspaceFolder}/.vscode/stdin"
            ]
        }
    ]
}